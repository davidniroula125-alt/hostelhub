PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hostelhub?replicaSet=rs0
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HostelHub <no-reply@hostelhub.app>
PAYMENT_GATEWAY=none
ESEWA_MERCHANT_ID=
KHALTI_SECRET_KEY=
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=500
