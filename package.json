{
  "name": "hostelhub",
  "version": "1.0.0",
  "private": true,
  "description": "HostelHub - Multi-tenant Hostel Management SaaS (web + android + ios + desktop)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "npm run test:e2e --workspace server",
    "desktop": "npm run desktop --workspace desktop",
    "android": "npm run android --workspace mobile",
    "ios": "npm run ios --workspace mobile"
  }
}